<!-- SVG placeholder for PRD formula -->
<svg width="300" height="80" xmlns="http://www.w3.org/2000/svg">
  <rect width="300" height="80" fill="#f0f0f0" stroke="#ccc"/>
  <text x="150" y="25" text-anchor="middle" dy="0.3em" font-family="Arial" font-size="12">PRD = 100 × √(Σ(f[i] - f̂[i])²)</text>
  <text x="150" y="45" text-anchor="middle" dy="0.3em" font-family="Arial" font-size="12">÷ √(Σ(f[i] - f̄)²)</text>
  <text x="150" y="65" text-anchor="middle" dy="0.3em" font-family="Arial" font-size="10">Lower is better</text>
</svg>